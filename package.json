{
  "name": "techbitsvsk-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://techbitsvsk.github.io",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "lint": "eslint .",
